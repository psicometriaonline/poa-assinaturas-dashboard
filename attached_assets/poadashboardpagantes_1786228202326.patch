+    mrrChange: round2(mrrAtEnd - mrrAtStart),
+    mrrChangePct: mrrAtStart > 0 ? pct(mrrAtEnd - mrrAtStart, mrrAtStart) : 0,
+    newMrr,
+    churnedMrr,
+    netNewMrr: round2(newMrr - churnedMrr),
+    quickRatio: churnedMrr > 0 ? round2(newMrr / churnedMrr) : null,
